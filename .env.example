# =============================================================
# Variáveis de Ambiente — Report Generator
# Copie este arquivo para .env.local e preencha os valores
# =============================================================

# Nome da organização que aparece no relatório
NEXT_PUBLIC_ORG_NAME="Prefeitura Municipal de Recife"

# Texto da marca d'água no PDF
WATERMARK_TEXT="CONFIDENCIAL"

# Mostrar ou esconder a marca d'água (true | false)
NEXT_PUBLIC_SHOW_WATERMARK="true"

# Cor da marca d'água em hex (sem #)
WATERMARK_COLOR="C0C0C0"

# URL base da aplicação (para meta tags, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
